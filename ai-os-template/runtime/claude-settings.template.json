{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/ai-os-hook.mjs --hook tool-cache-refresh",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/ai-os-hook.mjs --hook skill-activation",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/ai-os-hook.mjs --hook safety",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/ai-os-hook.mjs --hook verify-on-change",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node scripts/ai-os-hook.mjs --hook status-checkpoint",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
