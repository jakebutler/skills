{
  "version": "0.9.0",
  "project": "ai-os-template",
  "minimumNodeMajor": 22,
  "requiredPaths": [
    "README.md",
    "root/AGENTS.template.md",
    "routing/task-routes.json",
    "routing/model-evidence.json",
    "schemas/task-route-registry.schema.json",
    "runtime/mcp.template.json"
  ],
  "routeRegistry": "routing/task-routes.json",
  "toolCache": "runtime/tools.md",
  "stacks": ["convex"],
  "tools": [
    { "id": "codex", "command": "codex", "required": true, "versionArgs": ["--version"] },
    { "id": "claude", "command": "claude", "required": false, "versionArgs": ["--version"] },
    { "id": "cursor-agent", "command": "cursor-agent", "required": false, "versionArgs": ["--version"] },
    { "id": "convex", "command": "convex", "package": "convex", "required": false, "versionArgs": ["--version"] },
    { "id": "wrangler", "command": "wrangler", "package": "wrangler", "required": false, "versionArgs": ["--version"] },
    { "id": "supabase", "command": "supabase", "package": "supabase", "required": false, "versionArgs": ["--version"] }
  ],
  "hooks": {
    "blockingOverrideEnv": "AI_OS_ALLOW_LOCAL_BLOCKING_OVERRIDE",
    "verificationReminder": "Run focused verification after the coherent batch. Add one broad gate or independent review only when the actual risk and blast radius warrant it; reuse exact-diff evidence.",
    "toolsCacheRefresh": true,
    "delegatingReview": false
  }
}
