{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/native-builder-invocation.schema.json",
  "title": "Native Codex Builder Invocation Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "packet_type", "producer_version", "finalizer_version",
    "invocation_id", "experiment_id", "arm_id", "run_nonce", "model",
    "reasoning_effort", "execution_surface", "repository", "git_common_dir", "git_dir", "baseline_commit",
    "baseline_tree", "start_head", "start_index_tree", "start_ref",
    "start_ref_target", "start_status_sha256", "prompt_path", "prompt_sha256",
    "worker_packet_path", "worker_packet_sha256",
    "runner_config_sha256", "controls_sha256", "allowed_paths", "allowed_ignored_paths",
    "ignored_baseline_sha256", "environment_names", "environment_sha256",
    "execution_manifest", "execution_manifest_sha256", "timeout_ms",
    "check_timeout_ms", "intervention_budget", "remediation_generation_budget",
    "visible_checks", "held_out_checks", "evidence_directory",
    "invocation_packet_path", "result_path", "finalize_receipt_path"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "packet_type": { "const": "native-codex-exec-invocation-v3" },
    "producer_version": { "const": "native-codex-exec-producer-v3" },
    "finalizer_version": { "const": "native-codex-exec-finalizer-v3" },
    "invocation_id": { "$ref": "#/$defs/sha256" },
    "experiment_id": { "$ref": "#/$defs/id" },
    "arm_id": { "$ref": "#/$defs/id" },
    "run_nonce": { "$ref": "#/$defs/id" },
    "model": { "const": "gpt-5.6-sol" },
    "reasoning_effort": { "const": "high" },
    "execution_surface": { "const": "codex-exec" },
    "repository": { "type": "string", "minLength": 1 },
    "git_common_dir": { "type": "string", "minLength": 1 },
    "git_dir": { "type": "string", "minLength": 1 },
    "baseline_commit": { "$ref": "#/$defs/objectId" },
    "baseline_tree": { "$ref": "#/$defs/objectId" },
    "start_head": { "$ref": "#/$defs/objectId" },
    "start_index_tree": { "$ref": "#/$defs/objectId" },
    "start_ref": { "type": "string", "minLength": 1 },
    "start_ref_target": { "$ref": "#/$defs/objectId" },
    "start_status_sha256": { "$ref": "#/$defs/sha256" },
    "prompt_path": { "type": "string", "minLength": 1 },
    "prompt_sha256": { "$ref": "#/$defs/sha256" },
    "worker_packet_path": { "type": "string", "minLength": 1 },
    "worker_packet_sha256": { "$ref": "#/$defs/sha256" },
    "runner_config_sha256": { "$ref": "#/$defs/sha256" },
    "controls_sha256": { "$ref": "#/$defs/sha256" },
    "allowed_paths": { "$ref": "#/$defs/nonEmptyStrings" },
    "allowed_ignored_paths": { "$ref": "#/$defs/strings" },
    "ignored_baseline_sha256": { "$ref": "#/$defs/sha256" },
    "environment_names": { "$ref": "#/$defs/strings" },
    "environment_sha256": { "$ref": "#/$defs/sha256" },
    "execution_manifest": { "type": "object" },
    "execution_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "timeout_ms": { "type": "integer", "minimum": 1000 },
    "check_timeout_ms": { "type": "integer", "minimum": 1000 },
    "intervention_budget": { "type": "integer", "minimum": 0 },
    "remediation_generation_budget": { "type": "integer", "minimum": 0 },
    "visible_checks": { "$ref": "#/$defs/commands" },
    "held_out_checks": { "$ref": "#/$defs/commands" },
    "evidence_directory": { "type": "string", "minLength": 1 },
    "invocation_packet_path": { "type": "string", "minLength": 1 },
    "result_path": { "type": "string", "minLength": 1 },
    "finalize_receipt_path": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1 },
    "objectId": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "commands": { "type": "array", "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
  }
}
