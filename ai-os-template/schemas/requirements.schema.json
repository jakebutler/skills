{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/requirements.schema.json",
  "title": "Proof Harness Requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "baseline", "requirements"],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "$ref": "common.schema.json#/$defs/gitObject" },
        "tree": { "$ref": "common.schema.json#/$defs/gitObject" }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "source", "applies_to", "verification"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/identifier" },
          "statement": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "source": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "command", "expected", "denial_without_effects"],
            "properties": {
              "method": { "enum": ["test", "static_check", "manual_evidence"] },
              "command": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
              "expected": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
              "denial_without_effects": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
            }
          }
        }
      }
    }
  }
}
