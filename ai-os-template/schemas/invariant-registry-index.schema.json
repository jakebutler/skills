{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/invariant-registry-index.schema.json",
  "title": "Invariant Retrieval Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "invariants"],
  "properties": {
    "schema_version": { "const": 1 },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "statement", "always_apply", "applies_to", "dependencies", "required_evidence"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/stableId" },
          "status": { "enum": ["advisory", "active-blocking"] },
          "statement": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "always_apply": { "type": "boolean" },
          "applies_to": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kinds", "entities", "tags", "risks"],
            "properties": {
              "kinds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } },
              "entities": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } },
              "tags": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } },
              "risks": { "type": "array", "items": { "enum": ["low", "medium", "high"] } }
            }
          },
          "dependencies": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/stableId" } },
          "required_evidence": { "$ref": "common.schema.json#/$defs/nonEmptyStringArray" }
        }
      }
    }
  }
}
