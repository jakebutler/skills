{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/architecture-proof.schema.json",
  "title": "Proof Harness Architecture Proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "authority_effect_diagram",
    "decisions",
    "sibling_paths",
    "matrices",
    "review_units",
    "unresolved_assumptions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "authority_effect_diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "content", "trust_boundaries"],
      "properties": {
        "format": { "enum": ["mermaid", "text"] },
        "content": { "type": "string", "minLength": 1 },
        "trust_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decision" }
    },
    "sibling_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/siblingPath" }
    },
    "matrices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coherent_tamper", "lifecycle", "worker_progress"],
      "properties": {
        "coherent_tamper": { "type": "array", "items": { "$ref": "#/$defs/matrixRow" } },
        "lifecycle": { "type": "array", "items": { "$ref": "#/$defs/matrixRow" } },
        "worker_progress": { "type": "array", "items": { "$ref": "#/$defs/matrixRow" } }
      }
    },
    "review_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement_ids", "surface_ids", "depends_on"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/identifier" },
          "requirement_ids": { "$ref": "#/$defs/nonEmptyStrings" },
          "surface_ids": { "$ref": "#/$defs/nonEmptyStrings" },
          "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "unresolved_assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement_ids",
        "immutable_root",
        "canonical_projection",
        "cardinality",
        "creation_anchor",
        "lifecycle_semantics",
        "fail_closed_behavior",
        "enforcement_point"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/identifier" },
        "requirement_ids": { "$ref": "#/$defs/nonEmptyStrings" },
        "immutable_root": { "type": "string", "minLength": 1 },
        "canonical_projection": { "type": "string", "minLength": 1 },
        "cardinality": { "type": "string", "minLength": 1 },
        "creation_anchor": { "type": "string", "minLength": 1 },
        "lifecycle_semantics": { "type": "string", "minLength": 1 },
        "fail_closed_behavior": { "type": "string", "minLength": 1 },
        "enforcement_point": { "type": "string", "minLength": 1 }
      }
    },
    "siblingPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "entry_point", "effect_surface_ids", "enforcement_point", "requirement_ids"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/identifier" },
        "kind": { "enum": ["public", "internal", "direct", "scheduled", "retry", "recovery", "census", "quarantine", "post_retirement"] },
        "entry_point": { "type": "string", "minLength": 1 },
        "effect_surface_ids": { "$ref": "#/$defs/nonEmptyStrings" },
        "enforcement_point": { "type": "string", "minLength": 1 },
        "requirement_ids": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "matrixRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "applicability", "expected", "requirement_ids"],
      "properties": {
        "case": { "type": "string", "minLength": 1 },
        "applicability": { "enum": ["applicable", "not_applicable"] },
        "expected": { "type": "string", "minLength": 1 },
        "requirement_ids": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  }
}
