{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/active-invariant-registry.schema.json",
  "title": "Active Blocking Invariant Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "invariants"],
  "properties": {
    "schema_version": { "const": 1 },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "statement", "always_apply", "applies_to", "dependencies", "required_evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^INV-[A-Z0-9][A-Z0-9._-]+$" },
          "status": { "const": "active-blocking" },
          "statement": { "type": "string", "minLength": 1 },
          "always_apply": { "type": "boolean" },
          "applies_to": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kinds", "entities", "tags", "risks"],
            "properties": {
              "kinds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "entities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          },
          "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "required_evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
