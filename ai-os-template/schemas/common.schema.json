{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/common.schema.json",
  "title": "Proof Harness Common Definitions",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]*-[A-Z0-9_-]+$"
    },
    "stableId": {
      "$ref": "#/$defs/identifier"
    }
  }
}
