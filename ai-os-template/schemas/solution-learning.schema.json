{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/solution-learning.schema.json",
  "title": "AI OS grounded solution-learning candidate",
  "type": "object",
  "required": ["schema_version", "source_candidate"],
  "properties": {
    "schema_version": { "const": 1 },
    "disposition": { "enum": ["capture", "skip"] },
    "skip_reason": { "type": "string", "minLength": 1 },
    "track": { "enum": ["bug", "knowledge"] },
    "title": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "date": { "type": "string", "format": "date" },
    "category": { "type": "string", "minLength": 1 },
    "module": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "problem_type": { "type": "string", "minLength": 1 },
    "capture_reason": { "type": "string", "minLength": 1 },
    "source_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "git_commit", "route"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "git_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "route": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "source_kind", "author_id"],
      "properties": {
        "observed_at": { "type": "string", "format": "date-time" },
        "source_kind": { "type": "string", "minLength": 1 },
        "author_id": { "type": "string", "minLength": 1 }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validator_id", "status", "claims"],
      "properties": {
        "validator_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["verified", "degraded", "contradicted"] },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "statement", "status"],
            "properties": {
              "kind": { "enum": ["code", "documentation", "merge-state"] },
              "statement": { "type": "string", "minLength": 1 },
              "status": { "enum": ["verified", "degraded", "contradicted"] },
              "source_path": { "type": "string", "minLength": 1 },
              "source_quote": { "type": "string", "minLength": 1 },
              "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
              "historical": { "type": "boolean" },
              "verification_method": { "enum": ["github-live", "git-reachability", "offline"] },
              "evidence_url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "related": {
      "type": "object",
      "properties": {
        "docs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "issues": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" }
        }
      }
    },
    "discoverability_gap": {
      "type": "object",
      "required": ["target", "reason"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "oneOf": [
    {
      "required": ["disposition", "skip_reason"],
      "properties": { "disposition": { "const": "skip" } }
    },
    {
      "required": [
        "track",
        "title",
        "slug",
        "date",
        "category",
        "module",
        "tags",
        "problem_type",
        "capture_reason",
        "provenance",
        "content",
        "grounding"
      ],
      "not": {
        "required": ["disposition"],
        "properties": { "disposition": { "const": "skip" } }
      }
    }
  ]
}
