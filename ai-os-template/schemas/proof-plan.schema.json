{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/proof-plan.schema.json",
  "title": "Proof Harness Trace Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "entries", "requirement_trace", "orphan_requirements", "orphan_effects"],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface_id", "reachable_because", "requirement_ids", "invariant_ids", "enforcement_point", "negative_evidence", "integration_evidence", "disposition"],
        "properties": {
          "surface_id": { "type": "string", "minLength": 1 },
          "reachable_because": { "type": "string", "minLength": 1 },
          "requirement_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "invariant_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "enforcement_point": { "type": "string", "minLength": 1 },
          "negative_evidence": { "type": "string", "minLength": 1 },
          "integration_evidence": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["covered", "not_applicable"] }
        }
      }
    },
    "requirement_trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "enforcement_points", "verification_evidence", "status"],
        "properties": {
          "requirement_id": { "type": "string", "minLength": 1 },
          "enforcement_points": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "verification_evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "status": { "const": "covered" }
        }
      }
    },
    "orphan_requirements": { "type": "array", "maxItems": 0 },
    "orphan_effects": { "type": "array", "maxItems": 0 }
  }
}
