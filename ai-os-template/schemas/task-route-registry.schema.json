{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corvo.dev/schemas/task-route-registry.schema.json",
  "title": "AI OS task route registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "backboneRouteId", "policies", "routes", "tasks"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^0\\.8(?:\\.\\d+)?$" },
    "updatedAt": { "type": "string", "format": "date" },
    "backboneRouteId": { "type": "string", "minLength": 1 },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noSilentSubstitution",
        "communityEvidenceWeightCap",
        "evidenceMaxAgeDays",
        "maximumFallbacks"
      ],
      "properties": {
        "noSilentSubstitution": { "const": true },
        "communityEvidenceWeightCap": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.15
        },
        "evidenceMaxAgeDays": { "type": "integer", "minimum": 1 },
        "maximumFallbacks": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "runtime",
          "providerFamily",
          "model",
          "effort",
          "availability",
          "capabilities"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "runtime": {
            "type": "string",
            "enum": ["codex", "claude-code", "cursor-agent"]
          },
          "providerFamily": {
            "type": "string",
            "enum": ["openai", "anthropic", "cursor"]
          },
          "model": { "type": "string", "minLength": 1 },
          "effort": {
            "type": "string",
            "enum": ["low", "medium", "high", "xhigh", "max", "n/a"]
          },
          "availability": {
            "type": "string",
            "enum": ["verified", "conditional", "experimental"]
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "aliases",
          "primaryRouteId",
          "fallbackRouteIds",
          "confidence",
          "stopRule"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "primaryRouteId": { "type": "string", "minLength": 1 },
          "fallbackRouteIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "provisional"]
          },
          "requiresIndependentReview": { "type": "boolean" },
          "requiresRepoEval": { "type": "boolean" },
          "requiredCompanionRouteIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "stopRule": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
