{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/native-codex-capability-probe.schema.json",
  "title": "Native Codex Capability Probe Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_type", "invocation_packet_sha256",
    "codex_executable_path", "codex_executable_sha256", "codex_version",
    "launch_contract_sha256", "capability_probe_contract_sha256",
    "feature_inventory_stdout_path", "feature_inventory_stdout_sha256",
    "feature_inventory_stderr_path", "feature_inventory_stderr_sha256",
    "capability_probe_stdout_path", "capability_probe_stdout_sha256",
    "capability_probe_stderr_path", "capability_probe_stderr_sha256",
    "disabled_features", "observations", "passed"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_type": { "const": "native-codex-capability-probe-v1" },
    "invocation_packet_sha256": { "$ref": "#/$defs/sha256" },
    "codex_executable_path": { "$ref": "#/$defs/string" },
    "codex_executable_sha256": { "$ref": "#/$defs/sha256" },
    "codex_version": { "$ref": "#/$defs/string" },
    "launch_contract_sha256": { "$ref": "#/$defs/sha256" },
    "capability_probe_contract_sha256": { "$ref": "#/$defs/sha256" },
    "feature_inventory_stdout_path": { "$ref": "#/$defs/string" },
    "feature_inventory_stdout_sha256": { "$ref": "#/$defs/sha256" },
    "feature_inventory_stderr_path": { "$ref": "#/$defs/string" },
    "feature_inventory_stderr_sha256": { "$ref": "#/$defs/sha256" },
    "capability_probe_stdout_path": { "$ref": "#/$defs/string" },
    "capability_probe_stdout_sha256": { "$ref": "#/$defs/sha256" },
    "capability_probe_stderr_path": { "$ref": "#/$defs/string" },
    "capability_probe_stderr_sha256": { "$ref": "#/$defs/sha256" },
    "disabled_features": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/string" } },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_read", "visible_command_read", "visible_executable_read", "held_out_executable_read", "root_evidence_read", "tmp_write", "network_connect", "descendant_codex_agent"],
      "properties": {
        "workspace_read": { "$ref": "#/$defs/status" },
        "visible_command_read": { "$ref": "#/$defs/status" },
        "visible_executable_read": { "$ref": "#/$defs/status" },
        "held_out_executable_read": { "$ref": "#/$defs/status" },
        "root_evidence_read": { "$ref": "#/$defs/status" },
        "tmp_write": { "$ref": "#/$defs/status" },
        "network_connect": { "$ref": "#/$defs/status" },
        "descendant_codex_agent": { "$ref": "#/$defs/status" }
      }
    },
    "passed": { "const": true }
  },
  "$defs": {
    "string": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "type": "integer", "minimum": 0 } }
    }
  }
}
