{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/native-builder-attestation.schema.json",
  "title": "Native Codex Builder Orchestration Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attestation_type", "producer_version", "finalizer_version",
    "invocation_packet_sha256", "invocation_id", "experiment_id", "arm_id",
    "run_nonce", "canonical_task", "run_id", "model", "reasoning_effort",
    "execution_surface", "platform_version", "status", "agent_timed_out",
    "started_at", "finished_at", "repository", "baseline_commit", "baseline_tree",
    "start_head", "end_head", "start_index_tree", "end_index_tree", "start_ref",
    "end_ref", "start_ref_target", "end_ref_target", "start_status_sha256",
    "prompt_sha256", "runner_config_sha256", "controls_sha256",
    "worker_packet_sha256", "observed_prompt_sha256",
    "completion_evidence_path", "completion_evidence_sha256",
    "intervention_events", "manual_edits"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "attestation_type": { "const": "codex-collaboration-subagent-builder-attestation-v1" },
    "producer_version": { "const": "native-codex-producer-v1" },
    "finalizer_version": { "const": "native-codex-finalizer-v1" },
    "invocation_packet_sha256": { "$ref": "#/$defs/sha256" },
    "invocation_id": { "$ref": "#/$defs/sha256" },
    "experiment_id": { "$ref": "#/$defs/string" },
    "arm_id": { "$ref": "#/$defs/string" },
    "run_nonce": { "$ref": "#/$defs/string" },
    "canonical_task": { "type": "string", "pattern": "^/root/" },
    "run_id": { "$ref": "#/$defs/string" },
    "model": { "const": "gpt-5.6-sol" },
    "reasoning_effort": { "const": "high" },
    "execution_surface": { "const": "codex-collaboration-subagent" },
    "platform_version": { "$ref": "#/$defs/string" },
    "status": { "enum": ["completed", "failed", "timeout"] },
    "agent_timed_out": { "type": "boolean" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "repository": { "$ref": "#/$defs/string" },
    "baseline_commit": { "$ref": "#/$defs/objectId" },
    "baseline_tree": { "$ref": "#/$defs/objectId" },
    "start_head": { "$ref": "#/$defs/objectId" },
    "end_head": { "$ref": "#/$defs/objectId" },
    "start_index_tree": { "$ref": "#/$defs/objectId" },
    "end_index_tree": { "$ref": "#/$defs/objectId" },
    "start_ref": { "$ref": "#/$defs/string" },
    "end_ref": { "$ref": "#/$defs/string" },
    "start_ref_target": { "$ref": "#/$defs/objectId" },
    "end_ref_target": { "$ref": "#/$defs/objectId" },
    "start_status_sha256": { "$ref": "#/$defs/sha256" },
    "prompt_sha256": { "$ref": "#/$defs/sha256" },
    "runner_config_sha256": { "$ref": "#/$defs/sha256" },
    "controls_sha256": { "$ref": "#/$defs/sha256" },
    "worker_packet_sha256": { "$ref": "#/$defs/sha256" },
    "observed_prompt_sha256": { "$ref": "#/$defs/sha256" },
    "completion_evidence_path": { "$ref": "#/$defs/string" },
    "completion_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "intervention_events": { "type": "array", "items": { "type": "object" } },
    "manual_edits": { "type": "boolean" }
  },
  "$defs": {
    "string": { "type": "string", "minLength": 1 },
    "objectId": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
