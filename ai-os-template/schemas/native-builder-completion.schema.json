{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/native-builder-completion.schema.json",
  "title": "Native Codex Builder Returned Completion Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_type", "invocation_packet_sha256", "invocation_id",
    "experiment_id", "arm_id", "canonical_task", "run_id", "model",
    "reasoning_effort", "status", "controls_sha256", "worker_packet_sha256",
    "observed_prompt_sha256", "changed_paths",
    "observed_working_state_sha256", "returned_completion"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_type": { "const": "codex-collaboration-subagent-completion-v1" },
    "invocation_packet_sha256": { "$ref": "#/$defs/sha256" },
    "invocation_id": { "$ref": "#/$defs/sha256" },
    "experiment_id": { "$ref": "#/$defs/string" },
    "arm_id": { "$ref": "#/$defs/string" },
    "canonical_task": { "type": "string", "pattern": "^/root/" },
    "run_id": { "$ref": "#/$defs/string" },
    "model": { "const": "gpt-5.6-sol" },
    "reasoning_effort": { "const": "high" },
    "status": { "enum": ["completed", "failed", "timeout"] },
    "controls_sha256": { "$ref": "#/$defs/sha256" },
    "worker_packet_sha256": { "$ref": "#/$defs/sha256" },
    "observed_prompt_sha256": { "$ref": "#/$defs/sha256" },
    "changed_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/string" } },
    "observed_working_state_sha256": { "$ref": "#/$defs/sha256" },
    "returned_completion": { "$ref": "#/$defs/string" }
  },
  "$defs": {
    "string": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
